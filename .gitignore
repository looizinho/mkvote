# Cria .gitignore na raiz
cat > .gitignore << 'EOF'
# Dependencies
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml

# Build & Output
dist/
build/
out/
*.tsbuildinfo

# Environment
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-workspace

# OS
.DS_Store
Thumbs.db
.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary
.tmp/
temp/
*.tmp

# Testing
coverage/
.nyc_output/

# Misc
.cache/
.next/
EOF

# Add e commit
git add .gitignore
git commit -m "chore: add .gitignore"

# Push
git push origin main
